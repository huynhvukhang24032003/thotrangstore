@model ShopWebApp.Models.ApplicationUser
@{
    ViewData["Title"] = "Tài khoản của tôi";
    var roles = ViewBag.Roles as IList<string> ?? new List<string>();
    var isAdmin = roles.Contains("Admin");
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <!-- Header -->
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-3"
                 style="width:64px;height:64px;flex-shrink:0">
                @(string.IsNullOrEmpty(Model.FullName) ? "?" : Model.FullName[0].ToString().ToUpper())
            </div>
            <div>
                <h4 class="fw-bold mb-0">@Model.FullName</h4>
                <p class="text-muted mb-0">@Model.Email</p>
                <span class="badge @(isAdmin ? "bg-danger" : "bg-secondary")">@(roles.FirstOrDefault() ?? "Khách hàng")</span>
            </div>
        </div>

        <!-- Tabs -->
        <ul class="nav nav-tabs mb-4" id="profileTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-info" type="button">
                    <i class="bi bi-person me-1"></i>Thông tin cá nhân
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-password" type="button">
                    <i class="bi bi-shield-lock me-1"></i>Đổi mật khẩu
                </button>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Customer" asp-controller="Order" asp-action="Index">
                    <i class="bi bi-bag me-1"></i>Đơn hàng của tôi
                </a>
            </li>
        </ul>

        <div class="tab-content">
            <!-- Tab: Thông tin -->
            <div class="tab-pane fade show active" id="tab-info">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom fw-semibold">
                        <i class="bi bi-pencil-square me-2 text-primary"></i>Cập nhật thông tin
                    </div>
                    <div class="card-body p-4">
                        <form asp-action="Profile" method="post">
                            @Html.AntiForgeryToken()
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                                    <input type="text" name="fullName" value="@Model.FullName"
                                           class="form-control" placeholder="Nguyễn Văn A" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Email</label>
                                    <input type="email" value="@Model.Email" class="form-control" readonly
                                           style="background:#f8f9fa" />
                                    <small class="text-muted">Email không thể thay đổi</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Số điện thoại</label>
                                    <input type="tel" name="phone" value="@Model.Phone"
                                           class="form-control" placeholder="0901234567" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Địa chỉ giao hàng</label>
                                    <textarea name="address" class="form-control" rows="3"
                                              placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố">@Model.Address</textarea>
                                </div>
                            </div>
                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="bi bi-check-lg me-1"></i>Lưu thay đổi
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Thông tin bổ sung -->
                <div class="card border-0 shadow-sm mt-3">
                    <div class="card-body p-4">
                        <h6 class="fw-semibold mb-3 text-muted">
                            <i class="bi bi-info-circle me-1"></i>Thông tin tài khoản
                        </h6>
                        <div class="row g-2 small">
                            <div class="col-sm-6">
                                <span class="text-muted">Ngày tạo:</span>
                                <strong class="ms-2">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">Email xác thực:</span>
                                @if (Model.EmailConfirmed)
                                {
                                    <span class="ms-2 text-success fw-semibold"><i class="bi bi-check-circle me-1"></i>Đã xác thực</span>
                                }
                                else
                                {
                                    <span class="ms-2 text-warning fw-semibold"><i class="bi bi-exclamation-circle me-1"></i>Chưa xác thực</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab: Đổi mật khẩu -->
            <div class="tab-pane fade" id="tab-password">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom fw-semibold">
                        <i class="bi bi-key me-2 text-warning"></i>Đổi mật khẩu
                    </div>
                    <div class="card-body p-4">
                        <div class="row justify-content-center">
                            <div class="col-md-7">
                                <form asp-action="ChangePassword" method="post">
                                    @Html.AntiForgeryToken()
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Mật khẩu hiện tại</label>
                                        <div class="input-group">
                                            <input type="password" name="currentPassword" id="currentPassword"
                                                   class="form-control" placeholder="Nhập mật khẩu hiện tại" required />
                                            <button class="btn btn-outline-secondary" type="button"
                                                    onclick="togglePwd('currentPassword', this)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Mật khẩu mới</label>
                                        <div class="input-group">
                                            <input type="password" name="newPassword" id="newPassword"
                                                   class="form-control" placeholder="Ít nhất 6 ký tự" required />
                                            <button class="btn btn-outline-secondary" type="button"
                                                    onclick="togglePwd('newPassword', this)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
                                        <div class="input-group">
                                            <input type="password" name="confirmPassword" id="confirmPassword"
                                                   class="form-control" placeholder="Nhập lại mật khẩu mới" required />
                                            <button class="btn btn-outline-secondary" type="button"
                                                    onclick="togglePwd('confirmPassword', this)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-warning px-4">
                                        <i class="bi bi-shield-check me-1"></i>Cập nhật mật khẩu
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function togglePwd(inputId, btn) {
        const inp = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (inp.type === 'password') {
            inp.type = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            inp.type = 'password';
            icon.className = 'bi bi-eye';
        }
    }

    // Nếu có lỗi từ tab đổi mật khẩu, tự mở tab đó
    @if (TempData.Peek("_pwdTab") != null)
    {
        <text>
        document.addEventListener('DOMContentLoaded', function() {
            var tab = new bootstrap.Tab(document.querySelector('[data-bs-target="#tab-password"]'));
            tab.show();
        });
        </text>
    }
</script>
}
