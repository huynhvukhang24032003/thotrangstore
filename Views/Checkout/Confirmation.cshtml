@model ShopWebApp.Models.Order
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-5 text-center">
                <div class="mb-4">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                </div>
                <h3 class="fw-bold mb-2">Đặt hàng thành công!</h3>
                <p class="text-muted mb-4">Cảm ơn bạn đã mua hàng. Chúng tôi sẽ liên hệ xác nhận sớm nhất.</p>

                <div class="card bg-light border-0 text-start mb-4">
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-6">
                                <small class="text-muted">Mã đơn hàng</small>
                                <div class="fw-bold fs-5">#@Model.Id</div>
                            </div>
                            <div class="col-6">
                                <small class="text-muted">Ngày đặt</small>
                                <div class="fw-semibold">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <div class="col-6">
                                <small class="text-muted">Thanh toán</small>
                                <div class="fw-semibold">@(Model.PaymentMethod == ShopWebApp.Models.PaymentMethod.COD ? "Thanh toán khi nhận hàng" : Model.PaymentMethod.ToString())</div>
                            </div>
                            <div class="col-6">
                                <small class="text-muted">Tổng tiền</small>
                                <div class="fw-bold text-primary fs-5">@string.Format("{0:N0} ₫", Model.TotalAmount)</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card bg-light border-0 text-start mb-4">
                    <div class="card-body">
                        <small class="text-muted d-block">Địa chỉ giao hàng</small>
                        <div class="fw-semibold"><i class="bi bi-geo-alt me-1 text-primary"></i>@Model.ShippingAddress</div>
                    </div>
                </div>

                <div class="d-flex gap-3 justify-content-center">
                    <a asp-area="Customer" asp-controller="Order" asp-action="Details"
                       asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-receipt me-1"></i>Xem đơn hàng
                    </a>
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-grid me-1"></i>Tiếp tục mua sắm
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
