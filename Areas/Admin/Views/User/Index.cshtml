@model List<ShopWebApp.Models.ApplicationUser>
@{
    ViewData["Title"] = "Quản lý Người dùng";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
    var allRoles = ViewBag.AllRoles as List<string> ?? new List<string>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-people me-2"></i>Người dùng</h4>
    <span class="badge bg-primary fs-6">@((int)(ViewBag.TotalPages ?? 1) * 15) người</span>
</div>

<!-- Search & Filter -->
<form method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                   placeholder="Tìm theo tên, email, SĐT..." />
        </div>
    </div>
    <div class="col-md-3">
        <select name="role" class="form-select">
            <option value="">-- Tất cả vai trò --</option>
            @foreach (var r in allRoles)
            {
                <option value="@r" selected="@(ViewBag.Role == r)">@r</option>
            }
        </select>
    </div>
    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary flex-grow-1">
            <i class="bi bi-search me-1"></i>Tìm
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<!-- Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Người dùng</th>
                        <th>Email</th>
                        <th>Số điện thoại</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-5">
                            <i class="bi bi-people fs-2 d-block mb-2 opacity-25"></i>
                            Không tìm thấy người dùng nào
                        </td></tr>
                    }
                    @foreach (var user in Model)
                    {
                        var roles = userRoles?.ContainsKey(user.Id) == true ? userRoles[user.Id] : new List<string>();
                        var isLocked = user.LockoutEnd.HasValue && user.LockoutEnd > DateTimeOffset.UtcNow;
                        var isAdmin = roles.Contains("Admin");
                        <tr class="@(isLocked ? "table-danger" : "")">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-circle bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                         style="width:36px;height:36px;font-size:0.85rem;flex-shrink:0">
                                        @(string.IsNullOrEmpty(user.FullName) ? "?" : user.FullName[0].ToString().ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-semibold">@user.FullName</div>
                                    </div>
                                </div>
                            </td>
                            <td><small>@user.Email</small></td>
                            <td><small>@(user.Phone ?? "-")</small></td>
                            <td>
                                @foreach (var r in roles)
                                {
                                    <span class="badge @(r == "Admin" ? "bg-danger" : "bg-secondary")">@r</span>
                                }
                                @if (!roles.Any())
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td>
                                @if (isLocked)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>Bị khóa</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"><i class="bi bi-unlock-fill me-1"></i>Hoạt động</span>
                                }
                            </td>
                            <td><small class="text-muted">@user.CreatedAt.ToString("dd/MM/yyyy")</small></td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@user.Id"
                                       class="btn btn-outline-primary" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (user.Email != User.Identity?.Name)
                                    {
                                        <form asp-action="ToggleLock" method="post" class="d-inline">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-outline-@(isLocked ? "success" : "warning")"
                                                    title="@(isLocked ? "Mở khóa" : "Khóa")">
                                                <i class="bi bi-@(isLocked ? "unlock" : "lock")"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Xóa tài khoản @user.FullName?')">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-outline-danger" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="btn btn-sm text-muted" title="Tài khoản của bạn">
                                            <i class="bi bi-person-check"></i>
                                        </span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Phân trang -->
@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@i"
                       asp-route-search="@ViewBag.Search"
                       asp-route-role="@ViewBag.Role">@i</a>
                </li>
            }
        </ul>
    </nav>
}
