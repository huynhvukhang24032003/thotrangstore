@model List<ShopWebApp.Models.Category>
@{
    ViewData["Title"] = "Quản lý Danh mục";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-tags me-2"></i>Danh mục sản phẩm</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Thêm danh mục
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Tên danh mục</th>
                    <th>Slug</th>
                    <th>Số sản phẩm</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model)
                {
                    <tr>
                        <td>@cat.Id</td>
                        <td class="fw-semibold">@cat.Name</td>
                        <td><code>@cat.Slug</code></td>
                        <td><span class="badge bg-primary">@cat.Products.Count</span></td>
                        <td>
                            @if (cat.IsActive)
                            {
                                <span class="badge bg-success">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Vô hiệu</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-outline-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="ToggleActive" asp-route-id="@cat.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-warning" title="@(cat.IsActive ? "Vô hiệu hóa" : "Kích hoạt")">
                                        <i class="bi bi-@(cat.IsActive ? "eye-slash" : "eye")"></i>
                                    </button>
                                </form>
                                @if (cat.Products.Count == 0)
                                {
                                    <form asp-action="Delete" asp-route-id="@cat.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Xóa danh mục này?')">
                                        <button type="submit" class="btn btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Chưa có danh mục nào</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
