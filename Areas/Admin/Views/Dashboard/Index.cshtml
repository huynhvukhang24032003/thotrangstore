@model List<ShopWebApp.Models.Order>
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-speedometer2 me-2"></i>Dashboard</h2>
    <small class="text-muted">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
</div>

<!-- Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="fs-4 fw-bold">@ViewBag.TotalProducts</div>
                    <div class="small">Sản phẩm</div>
                </div>
                <i class="bi bi-box-seam fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="fs-4 fw-bold">@ViewBag.TotalOrders</div>
                    <div class="small">Đơn hàng</div>
                </div>
                <i class="bi bi-receipt fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-info text-white">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="fs-4 fw-bold">@ViewBag.TotalUsers</div>
                    <div class="small">Người dùng</div>
                </div>
                <i class="bi bi-people fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-warning text-dark">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="fs-4 fw-bold">@string.Format("{0:N0} ₫", ViewBag.TotalRevenue)</div>
                    <div class="small">Doanh thu</div>
                </div>
                <i class="bi bi-cash-stack fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<!-- Recent Orders -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom">
        <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Đơn hàng gần đây</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Khách hàng</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Ngày đặt</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.Id</td>
                            <td>@order.User?.FullName</td>
                            <td>@string.Format("{0:N0} ₫", order.TotalAmount)</td>
                            <td>
                                @{
                                    var (badgeClass, label) = order.Status switch
                                    {
                                        ShopWebApp.Models.OrderStatus.Pending => ("warning", "Chờ xử lý"),
                                        ShopWebApp.Models.OrderStatus.Processing => ("info", "Đang xử lý"),
                                        ShopWebApp.Models.OrderStatus.Shipping => ("primary", "Đang giao"),
                                        ShopWebApp.Models.OrderStatus.Completed => ("success", "Hoàn thành"),
                                        ShopWebApp.Models.OrderStatus.Cancelled => ("danger", "Đã hủy"),
                                        _ => ("secondary", "Không xác định")
                                    };
                                }
                                <span class="badge bg-@badgeClass">@label</span>
                            </td>
                            <td>@order.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-id="@order.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Chưa có đơn hàng nào</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
