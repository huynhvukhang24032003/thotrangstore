@model ShopWebApp.Models.Order
@{
    ViewData["Title"] = $"Đơn hàng #{Model.Id}";
    var (badgeClass, label) = Model.Status switch
    {
        ShopWebApp.Models.OrderStatus.Pending => ("warning", "Chờ xử lý"),
        ShopWebApp.Models.OrderStatus.Processing => ("info", "Đang xử lý"),
        ShopWebApp.Models.OrderStatus.Shipping => ("primary", "Đang giao"),
        ShopWebApp.Models.OrderStatus.Completed => ("success", "Hoàn thành"),
        ShopWebApp.Models.OrderStatus.Cancelled => ("danger", "Đã hủy"),
        _ => ("secondary", "?")
    };
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Quay lại
    </a>
    <h4 class="fw-bold mb-0">Chi tiết đơn hàng #@Model.Id</h4>
    <span class="badge bg-@badgeClass fs-6">@label</span>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom fw-bold">
                <i class="bi bi-person me-2"></i>Thông tin khách hàng
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-md-6">
                        <small class="text-muted">Họ tên</small>
                        <div class="fw-semibold">@(Model.User?.FullName ?? Model.GuestName)</div>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted">Email</small>
                        <div>@(Model.User?.Email ?? Model.GuestEmail)</div>
                    </div>
                    <div class="col-md-12 mt-2">
                        <small class="text-muted">Số điện thoại</small>
                        <div>@(Model.User?.PhoneNumber ?? Model.GuestPhone)</div>
                    </div>
                    <div class="col-12">
                        <small class="text-muted">Địa chỉ giao hàng</small>
                        <div><i class="bi bi-geo-alt me-1 text-primary"></i>@Model.ShippingAddress</div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Note))
                    {
                        <div class="col-12">
                            <small class="text-muted">Ghi chú</small>
                            <div>@Model.Note</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom fw-bold">
                <i class="bi bi-box-seam me-2"></i>Sản phẩm
            </div>
            <div class="card-body p-0">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th colspan="2">Sản phẩm</th>
                            <th>Đơn giá</th>
                            <th>SL</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td width="60">
                                    @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                    {
                                        <img src="@item.Product.ImageUrl" width="50" height="50"
                                             class="rounded object-fit-cover" />
                                    }
                                </td>
                                <td>@item.Product?.Name</td>
                                <td>@string.Format("{0:N0} ₫", item.UnitPrice)</td>
                                <td>x @(item.Quantity)</td>
                                <td class="fw-bold text-primary">@string.Format("{0:N0} ₫", item.SubTotal)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="4" class="text-end fw-bold">Tổng cộng:</td>
                            <td class="fw-bold text-primary fs-5">
                                @string.Format("{0:N0} ₫", Model.TotalAmount)
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom fw-bold">
                <i class="bi bi-gear me-2"></i>Cập nhật trạng thái
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">Trạng thái hiện tại: <span class="badge bg-@badgeClass">@label</span></p>
                <div class="d-flex flex-column gap-2">
                    @foreach (var s in Enum.GetValues<ShopWebApp.Models.OrderStatus>())
                    {
                        if (s == Model.Status) continue;
                        var statusLabel = s switch
                        {
                            ShopWebApp.Models.OrderStatus.Pending => "Chờ xử lý",
                            ShopWebApp.Models.OrderStatus.Processing => "Đang xử lý",
                            ShopWebApp.Models.OrderStatus.Shipping => "Đang giao hàng",
                            ShopWebApp.Models.OrderStatus.Completed => "Hoàn thành",
                            ShopWebApp.Models.OrderStatus.Cancelled => "Hủy đơn",
                            _ => s.ToString()
                        };
                        <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                            <input type="hidden" name="status" value="@s" />
                            <button type="submit" class="btn btn-outline-primary btn-sm w-100"
                                    onclick="return confirm('Chuyển sang: @statusLabel?')">
                                → @statusLabel
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
