@model ShopWebApp.Models.Order
@{
    ViewData["Title"] = $"Đơn hàng #{Model.Id}";
    var (badgeClass, label) = Model.Status switch
    {
        ShopWebApp.Models.OrderStatus.Pending => ("warning", "Chờ xử lý"),
        ShopWebApp.Models.OrderStatus.Processing => ("info", "Đang xử lý"),
        ShopWebApp.Models.OrderStatus.Shipping => ("primary", "Đang giao"),
        ShopWebApp.Models.OrderStatus.Completed => ("success", "Hoàn thành"),
        ShopWebApp.Models.OrderStatus.Cancelled => ("danger", "Đã hủy"),
        _ => ("secondary", "Không xác định")
    };
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-area="Customer" asp-controller="Order" asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Quay lại
    </a>
    <h4 class="fw-bold mb-0">Chi tiết đơn hàng #@Model.Id</h4>
    <span class="badge bg-@badgeClass fs-6">@label</span>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom fw-bold">
                <i class="bi bi-box-seam me-2"></i>Sản phẩm đặt mua
            </div>
            <div class="card-body p-0">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th colspan="2">Sản phẩm</th>
                            <th>Đơn giá</th>
                            <th>SL</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td width="60">
                                    @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                    {
                                        <img src="@item.Product.ImageUrl" width="50" height="50"
                                             class="rounded object-fit-cover" />
                                    }
                                </td>
                                <td class="fw-semibold">@item.Product?.Name</td>
                                <td>@string.Format("{0:N0} ₫", item.UnitPrice)</td>
                                <td>x@item.Quantity</td>
                                <td class="fw-bold text-primary">@string.Format("{0:N0} ₫", item.SubTotal)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="4" class="text-end fw-bold">Tổng cộng:</td>
                            <td class="fw-bold text-primary fs-5">@string.Format("{0:N0} ₫", Model.TotalAmount)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Thông tin đơn hàng</h6>
                <div class="mb-2">
                    <small class="text-muted">Ngày đặt</small>
                    <div>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div class="mb-2">
                    <small class="text-muted">Địa chỉ giao hàng</small>
                    <div><i class="bi bi-geo-alt me-1 text-primary"></i>@Model.ShippingAddress</div>
                </div>
                <div class="mb-2">
                    <small class="text-muted">Phương thức thanh toán</small>
                    <div>
                        @(Model.PaymentMethod == ShopWebApp.Models.PaymentMethod.COD
                            ? "Thanh toán khi nhận hàng" : Model.PaymentMethod.ToString())
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div>
                        <small class="text-muted">Ghi chú</small>
                        <div>@Model.Note</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
