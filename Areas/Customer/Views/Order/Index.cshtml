@model List<ShopWebApp.Models.Order>
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<h3 class="fw-bold mb-4"><i class="bi bi-bag me-2 text-primary"></i>Đơn hàng của tôi</h3>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-bag-x fs-1 text-muted d-block mb-3"></i>
        <h5 class="text-muted">Chưa có đơn hàng nào</h5>
        <a asp-area="" asp-controller="Shop" asp-action="Index" class="btn btn-primary mt-3">
            <i class="bi bi-grid me-2"></i>Mua sắm ngay
        </a>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var order in Model)
        {
            var (badgeClass, label) = order.Status switch
            {
                ShopWebApp.Models.OrderStatus.Pending => ("warning", "Chờ xử lý"),
                ShopWebApp.Models.OrderStatus.Processing => ("info", "Đang xử lý"),
                ShopWebApp.Models.OrderStatus.Shipping => ("primary", "Đang giao"),
                ShopWebApp.Models.OrderStatus.Completed => ("success", "Hoàn thành"),
                ShopWebApp.Models.OrderStatus.Cancelled => ("danger", "Đã hủy"),
                _ => ("secondary", "Không xác định")
            };
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold">Đơn #@order.Id</span>
                        <span class="text-muted ms-2 small">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <span class="badge bg-@badgeClass">@label</span>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-muted small mb-1">
                                <i class="bi bi-geo-alt me-1"></i>@order.ShippingAddress
                            </div>
                            <div class="small">
                                @foreach (var item in order.OrderItems.Take(2))
                                {
                                    <span class="badge bg-light text-dark me-1">
                                        @item.Product?.Name x@item.Quantity
                                    </span>
                                }
                                @if (order.OrderItems.Count > 2)
                                {
                                    <span class="text-muted small">+@(order.OrderItems.Count - 2) sản phẩm khác</span>
                                }
                            </div>
                        </div>
                        <div class="col-auto text-end">
                            <div class="fw-bold text-primary fs-5 mb-1">
                                @string.Format("{0:N0} ₫", order.TotalAmount)
                            </div>
                            <a asp-area="Customer" asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i>Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
